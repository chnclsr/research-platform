DATABASE_URL=postgresql+asyncpg://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=research
MINIO_SECRET_KEY=change-me-now
MINIO_SECURE=false
# MinIO veri dizini. Named volume yerine host klasoru; asil sunucuda genis diskteki
# bir yola isaret ettirin. docker compose down -v bu veriyi SILMEZ.
MINIO_DATA_DIR=./data/minio
AGENTSEARCH_URL=http://host.docker.internal:3939
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=local-crawl-token
CRAWL4AI_SECRET_KEY=change-me-crawl-secret-at-least-32-chars
# GitHub repo URL'lerini HTML yerine depth-1 clone ile README + kaynak metnine cevirir.
# Checkout her sonuc yolunda silinir; sinirlar buyuk repolarin acquisition'i doldurmasini onler.
ENABLE_GITHUB_REPOSITORY_HANDLER=true
GITHUB_CLONE_TIMEOUT_S=90
GITHUB_REPOSITORY_MAX_BYTES=104857600
GITHUB_REPOSITORY_MAX_FILES=200
GITHUB_REPOSITORY_MAX_FILE_BYTES=524288
GITHUB_REPOSITORY_MAX_CHARS=2000000
# Crawl4AI basarisizligindan sonra anonim dis Jina Reader; hedef URL ucuncu tarafa gider.
# Kimlik bilgisi gonderilmez. Kapatmak icin false, self-host icin URL'yi degistirin.
ENABLE_JINA_READER_FALLBACK=true
JINA_READER_URL=https://r.jina.ai
JINA_READER_TIMEOUT_S=90
OLLAMA_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_THINK=false
LLM_REASON_THEN_FORMAT=false
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_OUTPUT_TOKENS=20480
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0
# Model profiline göre opsiyonel: LLM_TOP_P, LLM_TOP_K, LLM_PRESENCE_PENALTY
# Nanbeige gibi modeller için opsiyonel: LLM_MIN_P, LLM_REPEAT_PENALTY
EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
FIGURE_ANALYSIS_ENABLED=true
VISION_MODEL=qwen3.5:4b
FIGURE_MAX_CANDIDATES=8
FIGURE_MAX_PAGES_PER_SOURCE=3
FIGURE_MIN_RELEVANCE=0.55
FIGURE_ANALYSIS_TIMEOUT_S=180
FIGURE_SOURCE_EMBEDDING_ENABLED=true
FIGURE_SOURCE_MAX_EXPORTS=5
FIGURE_SOURCE_MIN_CONFIDENCE=0.70
PASSAGE_TARGET_TOKENS=700
PASSAGE_OVERLAP_TOKENS=100
PASSAGES_PER_QUESTION=8
LOCAL_CORPUS_RESULTS=8
FRONTIER_MAX_LINKS_PER_DOCUMENT=50
FRONTIER_MAX_DEPTH=2
ACQUISITION_CONCURRENCY=4
ENABLE_SCRAPLING_FALLBACK=true
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
GITHUB_TOKEN=
EPO_OPS_KEY=
EPO_OPS_SECRET=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
CROSSREF_RPS=1
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_RPS=1
SEMANTIC_SCHOLAR_CITATION_LIMIT=20
ZOTERO_LOCAL_URL=http://host.docker.internal:23119/api
ZOTERO_LOCAL_ENABLED=true
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_GROUP_ID=
ZOTERO_INCLUDE_NOTES=true
ZOTERO_INCLUDE_ATTACHMENTS=true
PAPERQA2_ENABLED=false
PAPERQA2_SHADOW_MODE=true
PAPERQA2_MAX_DOCUMENTS=20
API_TOKEN=change-me-local-token
RESEARCH_API_URL=http://localhost:8000
CONTROL_PANEL_HOST=127.0.0.1
CONTROL_PANEL_PORT=8020
CONTROL_PANEL_ALLOWED_NETWORKS=[]
# native | docker - panelin baslat/durdur ve durum kaynagi
CONTROL_PANEL_DEPLOYMENT=docker
GATEWAY_DOWNLOAD_DIR=./data/deliveries
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8010
# MCP has no shared token. Each caller presents their own API key, minted with
# research-admin issue-key <email> --name claude-desktop
MCP_ALLOWED_ORIGINS=[]
# Required when MCP_HOST is not loopback. Note that Docker Desktop may NAT published
# ports, in which case the real perimeter is the host firewall rule, not this list.
MCP_ALLOWED_NETWORKS=[]
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=[]
TELEGRAM_ALLOWED_CHAT_IDS=[]
TELEGRAM_ALLOW_GROUP_CHATS=false
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_DEFAULT_MAX_WALL_MINUTES=20
TELEGRAM_MAX_WALL_MINUTES=180
TELEGRAM_DEFAULT_MAX_ROUNDS=3
# Dusen kosu bildirimi bu kadar geriye bakar; daha eski hatalar duyurulmaz
TELEGRAM_FAILURE_NOTICE_WINDOW_H=24
PIPELINE_CONTROL_POLL_S=1
SEARCH_STAGE_TIMEOUT_S=600
ACQUISITION_STAGE_TIMEOUT_S=900
# Shared run-window hardware telemetry. CPU/RAM describe Docker/WSL; GPU counters
# describe total visible device load, including concurrent runs and other applications.
HARDWARE_TELEMETRY_ENABLED=true
HARDWARE_TELEMETRY_INTERVAL_S=5
HARDWARE_TELEMETRY_FLUSH_S=60
HARDWARE_TELEMETRY_MAX_BUFFERED_SAMPLES=720
# csv = 18_*.csv + 19_*summary.json; all = ayrica 20_*.svg grafigi
HARDWARE_TELEMETRY_OUTPUT_TYPE=all

# --- Uygulama davranisi ve kapasite sinirlari -------------------------------
# Giris guvenligi ve calisma kapasitesi
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
CAPACITY_ABSOLUTE_GUARD=8
CAPACITY_PROBE_TIMEOUT_S=5
MODEL_MAX_CONCURRENT_CALLS=1
CHECKPOINT_MAX_BYTES=209715200

# Worker, veritabani ve kuyruk
HTTP_TRANSPORT_RETRIES=3
WORKER_JOB_TIMEOUT_S=86400
WORKER_KEEP_RESULT_S=60
WORKER_HEALTH_CHECK_INTERVAL_S=30
DB_POOL_MIN_SIZE=10
DB_POOL_PER_RUN=5
DB_OVERFLOW_MIN_SIZE=10
DB_OVERFLOW_PER_RUN=3
QUEUE_PRIORITY_SHIFT_DAYS=3650
QUEUE_JOB_EXPIRY_S=86400

# API ve servis istemcileri
REDIS_STARTUP_CONNECT_ATTEMPTS=30
REDIS_OPERATION_CONNECT_ATTEMPTS=3
REDIS_PROBE_CONNECT_ATTEMPTS=1
REDIS_CONNECT_DELAY_S=1
SERVICE_HEALTH_TIMEOUT_S=3
GATEWAY_CLIENT_TIMEOUT_S=60
GATEWAY_ARTIFACT_MAX_CHARS=100000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_S=180
ACQUISITION_MAX_REDIRECTS=5
AGENTSEARCH_READ_MAX_CHARS=100000
CRAWL4AI_TIMEOUT_S=90

# Pipeline butceleri
SEARCH_CONCURRENCY=8
CITATION_SEED_MIN=4
CITATION_SEED_MAX=12
EVIDENCE_EXTRACTION_CONCURRENCY=2
RELEVANCE_RETRY_ATTEMPTS=2
GRAPH_RECURSION_MIN=80
GRAPH_RECURSION_MAX=5000
GRAPH_RECURSION_PER_WALL_MINUTE=20
FIRST_ROUND_SOURCE_FRACTION=0.40
LATER_ROUND_SOURCE_FRACTION=0.30
# --- PDF sayfa yonlendirme ---------------------------------------------------
# Esik profili. Bos = depo varsayilani (config/smart_router.yaml). Dosyanin
# icerigi `esik_version`e hash'lenip provenance'a yazilir, yani esik degisince
# surum de degisir. Dosya yoksa/bozuksa gomulu varsayilanlara dusulur ve durum
# parser health'inde gorunur.
#
# YORUM SATIRINDA BIRAKILDI, bilerek: docker-compose bu dosyayi env_file olarak
# okuyor ve BOS bir deger imajin kendi ENV'ini golgeler -- Dockerfile
# /app/config/smart_router.yaml'i acikca gosteriyor, bos satir onu geri alir.
# Baska bir profile isaret etmek istiyorsan basindaki # isaretini kaldir.
#SMART_ROUTER_CONFIG_PATH=
# Istemci tarafinda ayni anda kac agir cikarim baslatilabilir. Gercek sinir servis
# tarafindaki DOCLING_MAX_CONCURRENT'tir (tek kart, tek donusturme); bu, acquisition'in
# ona karsi sinirsiz sayida yukleme acmasini engelleyen sirt basincidir.
SMART_ROUTER_MAX_CONCURRENT_HEAVY=1

# --- Agir yol (docling) ------------------------------------------------------
# Agir motora ulasmanin uc yolu var; sirayla denenir: servis, koprulu, ayni surec.
#
# 1) SERVIS -- kapsayicidaki dogru cevap. docker-compose.yml `docling` servisini
#    tanimlar ve bu degiskeni zaten ona isaret ettirir, bu yuzden burada yorumda
#    birakildi: BOS bir deger compose'un verdigi degeri golgelerdi.
#    Modeller serviste yerlesik kalir; belge basina ~24 sn model yukleme maliyeti
#    (olculdu 2026-08-21, 671 sn'lik korpus kosusunun ~%43'u) burada sifirlanir.
#SMART_ROUTER_DOCLING_URL=http://docling:3941
#
# 2) KOPRULU -- host uzerinde gelistirme icin. Docling'in kurulu oldugu ayri bir
#    yorumlayiciyi gosterir; ana venv'e docling kurmak gerekmez. Ornek (Windows):
#    SMART_ROUTER_DOCLING_PYTHON=C:\Users\<kullanici>\.venv-docling\Scripts\python.exe
#    Bir kapsayicidan baska bir kapsayiciya ULASMAZ -- orada 1. yolu kullan.
SMART_ROUTER_DOCLING_PYTHON=
#
# 3) AYNI SUREC -- varsayilan olarak KAPALI. Bu surecte baslamis bir donusturme
#    durdurulamaz; parse() acquisition'in iptal edemedigi bir is parcaciginda
#    kosuyor, yani asan bir belge tek agir motor yuvasini bitene kadar tutar.
#    Bunu bilerek kabul ediyorsan 1 yap.
#SMART_ROUTER_ALLOW_IN_PROCESS=1
#
# Ucu de yoksa: health "TEXT ONLY -- no heavy engine" der, yonlendirilen sayfalar
# hizli yol metnini korur, belge `degraded` isaretlenir ve TARANMIS PDF'ler
# acquisition'in 400 karakter kapisinda dusar.

# --- Agir yol butceleri ------------------------------------------------------
# Sabit sayilardir (yukten turetilmez) ama dagitima baglidir: CPU kurulumu GPU'lu
# olandan ~3x yavastir ve tek bir sayi ikisine birden hizmet edemez. Compose bunlari
# zaten veriyor -- base dosya CPU degerlerini, docker-compose.gpu.yml GPU
# degerlerini. Elle ayar gerekmez; asagisi yalniz ne olduklarini soyler.
#
#   SMART_ROUTER_QUEUE_WAIT_S     bir belgenin yuva icin bekleyecegi sure.
#                                 CPU 900 / GPU 300. Dusuk kalirsa kuyrugun sonu
#                                 `queue-timeout` ile degraded doner.
#   SMART_ROUTER_HEAVY_TIMEOUT_S  tek belgenin agir yolda harcayabilecegi sure.
#                                 CPU 1800 / GPU 900.

# --- GPU'lu makine -----------------------------------------------------------
# Bu iki satiri ekle; gerisi degismez, her zamanki `docker compose up -d --build`
# GPU yapilandirmasini da kapsar:
#
#   COMPOSE_PATH_SEPARATOR=:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# IKI SATIR DA GEREKLI: COMPOSE_FILE'in ayraci Windows'ta ";", digerlerinde ":".
# Ayraci acikca yazmak ayni iki satiri iki platformda da calistirir.
#
# Overlay `docling` servisini CUDA yapisina cevirir ve karti rezerve eder. Servis
# CUDA bulamazsa BASLAMAZ -- CPU ve GPU ayni metni uretmiyor (261 sayfalik korpusta
# 7 sayfa farkli, biri bir markdown tablosunu kaybediyor) ve content_hash o metnin
# sha256'si. Sessizce CPU'ya dusmek her belgenin kimligini degistirirdi.

# Research Platform v0.5.2 | Belge sürümü: 1.4 | 2026-07-17
